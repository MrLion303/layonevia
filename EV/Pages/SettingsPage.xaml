<UserControl x:Class="EV.Pages.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock Text="General" FontSize="20" FontWeight="SemiBold"/>
     <CheckBox x:Name="StartWithWindowsBox" Content="Iniciar EV con Windows" Foreground="{StaticResource TextBrush}" Margin="0,18,0,8" Checked="GeneralSetting_Changed" Unchecked="GeneralSetting_Changed"/>
     <CheckBox x:Name="VoiceResponseBox" Content="Responder por voz" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,8" Checked="GeneralSetting_Changed" Unchecked="GeneralSetting_Changed"/>
     <CheckBox x:Name="WakeWordBox" Content="Escuchar la palabra de activación" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,8" Checked="GeneralSetting_Changed" Unchecked="GeneralSetting_Changed"/>
     <TextBlock Text="Palabra de activación" FontWeight="SemiBold" Margin="0,22,0,6"/>
     <TextBox Text="Oye ibi" MaxWidth="300" IsReadOnly="True"/>
    </StackPanel>
   </Border>

   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
    <StackPanel>
     <TextBlock Text="Inteligencia" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Conecta una API compatible con la Responses API para que EV pueda conversar, entender comentarios y mantener el contexto de la charla."
                Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>

     <TextBlock Text="Clave de API" FontWeight="SemiBold"/>
     <PasswordBox x:Name="ApiKeyBox" MaxWidth="520" Margin="0,6,0,14"/>

     <TextBlock Text="Modelo" FontWeight="SemiBold"/>
     <TextBox x:Name="ModelBox" MaxWidth="520" Text="gpt-6-luna" Margin="0,6,0,14"/>

     <TextBlock Text="Endpoint" FontWeight="SemiBold"/>
     <TextBox x:Name="EndpointBox" MaxWidth="520" Text="https://api.openai.com/v1/responses" Margin="0,6,0,16"/>

     <StackPanel Orientation="Horizontal">
      <Button Content="Guardar inteligencia" Click="SaveAi_Click" Padding="16,8"/>
      <Button Content="Probar conexión" Click="TestAi_Click" Padding="16,8" Margin="8,4,0,4"/>
      <Button Content="Borrar clave" Click="ClearAi_Click" Padding="16,8" Margin="8,4,0,4"/>
      <TextBlock x:Name="AiStatus" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
     </StackPanel>

     <TextBlock Text="La clave se guarda cifrada con Windows DPAPI y no se incluye en el repositorio."
                Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>