<UserControl x:Class="EV.Pages.MemoryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
   <StackPanel>
    <TextBlock Text="Memoria de EV" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Las memorias permanentes se sincronizarán con GitHub cuando haya conexión. Por seguridad, no se deben guardar en un repositorio público." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20"/>
    <TextBlock Text="Ejemplo" FontWeight="SemiBold"/>
    <TextBlock Text="«EV, recuerda que siempre debes llamarme Señor.»" Foreground="{StaticResource AccentBrush}" Margin="0,7,0,0"/>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>