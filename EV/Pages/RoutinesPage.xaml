<UserControl x:Class="EV.Pages.RoutinesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="300"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,14,0">
   <DockPanel>
    <Button DockPanel.Dock="Bottom" Content="Actualizar" Click="Refresh_Click" Margin="0,8,0,0"/>
    <ListBox x:Name="RoutineList" SelectionChanged="RoutineList_SelectionChanged"/>
   </DockPanel>
  </Border>
  <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock x:Name="RoutineName" Text="Rutinas" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock x:Name="RoutineDescription" Text="Selecciona una rutina para ver sus pasos." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
     <TextBlock Text="Pasos" FontWeight="SemiBold"/>
     <ItemsControl x:Name="StepList" Margin="0,8,0,18"/>
     <StackPanel Orientation="Horizontal">
      <Button Content="Ejecutar" Click="Run_Click" Margin="0,4,8,4"/>
      <Button Content="Eliminar" Click="Delete_Click" Margin="0,4,8,4"/>
     </StackPanel>
     <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>